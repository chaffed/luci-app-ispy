#!/bin/sh /etc/rc.common
# ISPy scheduler service
# shellcheck shell=dash disable=SC2034

START=99
STOP=10
USE_PROCD=1

# The instance always runs (it idles while disabled) and is restarted by
# procd whenever /etc/config/ispy changes, so new settings apply at once.
start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ispy daemon
	procd_set_param file /etc/config/ispy
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ispy
}
