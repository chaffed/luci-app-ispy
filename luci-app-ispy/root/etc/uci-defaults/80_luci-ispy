#!/bin/sh
# Make the new menu entry and rpcd object visible without a reboot.
rm -f /tmp/luci-indexcache* 2>/dev/null
rm -rf /tmp/luci-modulecache 2>/dev/null
/etc/init.d/rpcd reload 2>/dev/null

# reload_config only notices changes to configs it already has a checksum
# for; register ours so the first "Save & Apply" restarts the scheduler.
if [ -f /var/run/config.md5 ] && ! grep -q '/var/run/config.check/ispy$' /var/run/config.md5; then
	mkdir -p /var/run/config.check
	uci show ispy > /var/run/config.check/ispy 2>/dev/null
	md5sum /var/run/config.check/ispy >> /var/run/config.md5
	rm -rf /var/run/config.check
fi

/etc/init.d/ispy enable 2>/dev/null
/etc/init.d/ispy restart 2>/dev/null
exit 0
